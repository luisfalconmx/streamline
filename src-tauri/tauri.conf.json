{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Streamline",
  "version": "0.1.4",
  "identifier": "com.luisfalconmx.streamline",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Streamline",
        "width": 1120,
        "height": 780,
        "minWidth": 860,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Descarga videos sin l\u00edmites de velocidad",
    "longDescription": "Streamline es una app de escritorio para descargar videos y audio de YouTube y m\u00e1s de 1800 sitios, impulsada por yt-dlp.",
    "copyright": "\u00a9 2026 luisfalconmx",
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/deno"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "resources": {
      "../extension/": "extension/"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "streamline"
        ]
      }
    }
  }
}
